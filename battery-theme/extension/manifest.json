{
    "manifest_version": 3,
    "name": "Battery Theme",
    "version": "1.1.0",
    "description": "Ambient battery indicator that themes Firefox based on battery state",
    "permissions": [
        "theme",
        "nativeMessaging"
    ],
    "background": {
        "scripts": ["background.js"]
    },
    "action": {
        "default_title": "Battery Theme"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "battery-theme@willy.dev",
            "strict_min_version": "115.0"
        }
    }
}